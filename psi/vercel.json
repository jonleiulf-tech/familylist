{
  "rewrites": [
    { "source": "/((?!assets/|favicon-32\\.png|favicon-192\\.png|icon-512\\.png|logo/|images/|robots\\.txt|sitemap\\.xml|og-image\\.png|apple-touch-icon\\.png|manifest\\.webmanifest|img/).*)", "destination": "/index.html" }
  ],
  "headers": [
    {
      "source": "/(.*)",
      "headers": [
        { "key": "X-Content-Type-Options", "value": "nosniff" },
        { "key": "X-Frame-Options", "value": "DENY" },
        { "key": "Referrer-Policy", "value": "strict-origin-when-cross-origin" }
      ]
    },
    {
      "source": "/assets/(.*)",
      "headers": [{ "key": "Cache-Control", "value": "public, max-age=31536000, immutable" }]
    }
  ]
}
