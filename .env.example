# Supabase — hentes fra Dashboard > Project Settings > API
# Disse to er TRYGGE i frontend (anon-nøkkelen er beskyttet av RLS).
VITE_SUPABASE_URL=https://<ditt-prosjekt-ref>.supabase.co
VITE_SUPABASE_ANON_KEY=<anon public key>

# MERK: KASSALAPP_API_KEY skal ALDRI ligge her eller andre steder i frontend.
# Den settes som secret på Edge Function:
#   supabase secrets set KASSALAPP_API_KEY=<ny nøkkel>
