{
  "name": "familylist",
  "private": true,
  "version": "0.1.0",
  "type": "module",
  "description": "Smart handleliste- og middagsplanlegger for én familie",
  "scripts": {
    "dev": "vite",
    "build": "vite build",
    "preview": "vite preview",
    "seed:generate": "node scripts/generate-seed.mjs",
    "db:push": "supabase db push",
    "fn:deploy": "npm run sync:shared && supabase functions deploy",
    "test": "node scripts/check-undefined.mjs && vitest run",
    "test:watch": "vitest",
    "sync:shared": "node scripts/sync-shared.mjs",
    "sync:check": "node scripts/sync-shared.mjs --check",
    "recipes:sources": "node scripts/generate-recipe-sources-sql.mjs",
    "recipes:audit": "node scripts/audit-recipe-sources.mjs",
    "recipes:harvest": "node scripts/harvest-recipes.mjs",
    "recipes:diagnose": "node scripts/diagnose-recipe-page.mjs",
    "offers:harvest": "node scripts/harvest-offers.mjs",
    "offers:diagnose": "node scripts/diagnose-offer-page.mjs",
    "check:undefined": "node scripts/check-undefined.mjs"
  },
  "dependencies": {
    "@supabase/supabase-js": "^2.45.4",
    "@vercel/analytics": "^2.0.1",
    "lucide-react": "^0.454.0",
    "react": "^18.3.1",
    "react-dom": "^18.3.1"
  },
  "devDependencies": {
    "@testing-library/react": "^16.3.3",
    "@vitejs/plugin-react": "^4.3.3",
    "jsdom": "^30.0.1",
    "sharp": "^0.35.4",
    "vite": "^5.4.10",
    "vitest": "^4.1.11"
  }
}
